---
import { contactInfo, socialLinks, buildWhatsApp } from '../data/site';

const youtubeEmbed = `https://www.youtube.com/embed/${contactInfo.youtubeVideoId}`;
---

<section
	id="contato"
	class="w-full bg-petroleum-900 py-16 sm:py-20 lg:py-28"
	aria-labelledby="contato-title"
>
	<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="mx-auto max-w-3xl text-center">
			<h2
				id="contato-title"
				class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-[2.25rem]"
			>
				Entre em Contato
			</h2>
			<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
			<p class="mt-6 text-base text-white/85 sm:text-lg">
				Pronto para transformar sua equipe? Entre em contato agora
			</p>
		</header>

		<div class="mt-12 grid gap-8 lg:mt-16 lg:grid-cols-2 lg:gap-10">
			<!-- Coluna esquerda: vídeo + CTAs -->
			<div class="flex flex-col gap-6">
				<div class="rounded-2xl bg-petroleum-850 p-5 sm:rounded-3xl sm:p-6">
					<h3 class="text-lg font-bold text-white sm:text-xl">Vídeo de Apresentação</h3>
					<div class="mt-4 overflow-hidden rounded-xl bg-black/30">
						<div class="relative aspect-video w-full">
							<!-- Lightweight YouTube facade: loads iframe only on click -->
							<div
								class="youtube-facade relative h-full w-full"
								data-video-id={contactInfo.youtubeVideoId}
								role="button"
								aria-label="Reproduzir vídeo de apresentação"
								tabindex="0"
							>
								<img
									src={`https://i.ytimg.com/vi/${contactInfo.youtubeVideoId}/hqdefault.jpg`}
									alt="Thumbnail do vídeo de apresentação"
									class="absolute inset-0 h-full w-full object-cover"
									loading="lazy"
									width="1280"
									height="720"
								/>
								<button
									class="pointer-events-auto absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-black/60 p-4 text-white"
									aria-label="Reproduzir vídeo"
								>
									<svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M8 5v14l11-7z"></path>
									</svg>
								</button>
							</div>
						</div>
					</div>
				</div>

				<!-- Minimal JS to replace facade with real iframe on click/Enter -->
				<script is:inline>
					(() => {
						const mount = (el) => {
							const id = el.dataset.videoId;
							if (!id) return;
							const iframe = document.createElement('iframe');
							iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
							iframe.title = 'Vídeo de apresentação — Instituto Recomeçar e Leonardo Precioso';
							iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
							iframe.loading = 'lazy';
							iframe.className = 'absolute inset-0 h-full w-full';
							el.innerHTML = '';
							el.appendChild(iframe);
						};
						document.addEventListener('click', (e) => {
							const t = e.target;
							const el = t.closest && t.closest('.youtube-facade');
							if (el) mount(el);
						});
						document.addEventListener('keydown', (e) => {
							if (e.key === 'Enter' || e.key === ' ') {
								const active = document.activeElement;
								if (active && active.classList && active.classList.contains('youtube-facade')) {
									e.preventDefault();
									mount(active);
								}
							}
						});
					})();
				</script>

				<div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap">
					<a
						href={buildWhatsApp('Olá, gostaria de contratar uma palestra.')}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex flex-1 items-center justify-center gap-2 rounded-pill bg-accent px-6 py-3.5 text-sm font-bold text-petroleum-950 no-underline transition-colors hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:text-base"
					>
						<svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"
							></path>
						</svg>
						Contratar Palestra
					</a>
					<a
						href={buildWhatsApp('Olá, gostaria de solicitar um orçamento.')}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex flex-1 items-center justify-center gap-2 rounded-pill border-2 border-white bg-transparent px-6 py-3.5 text-sm font-bold text-white no-underline transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:text-base"
					>
						Solicitar Orçamento
					</a>
				</div>
			</div>

			<!-- Coluna direita: informações -->
			<div class="rounded-2xl bg-petroleum-850 p-5 sm:rounded-3xl sm:p-6 lg:p-8">
				<h3 class="text-lg font-bold text-white sm:text-xl">Informações de Contato</h3>

				<ul class="mt-6 space-y-6">
					<li class="flex items-start gap-4">
						<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-accent text-white" aria-hidden="true">
							<svg
								class="h-6 w-6"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path
									d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"
								></path>
							</svg>
						</div>
						<div>
							<p class="text-sm font-medium text-white/70">Telefone/WhatsApp</p>
							<a
								href={contactInfo.phoneHref}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 block text-lg font-bold text-white no-underline transition-colors hover:text-accent"
							>
								{contactInfo.phone}
							</a>
						</div>
					</li>
					<li class="flex items-start gap-4">
						<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-accent text-white" aria-hidden="true">
							<svg
								class="h-6 w-6"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<rect x="3" y="5" width="18" height="14" rx="2" />
								<path d="M3 7l9 6 9-6" />
							</svg>
						</div>
						<div>
							<p class="text-sm font-medium text-white/70">Email</p>
							<a
								href={`mailto:${contactInfo.email}`}
								class="mt-1 block break-all text-lg font-bold text-white no-underline transition-colors hover:text-accent"
							>
								{contactInfo.email}
							</a>
						</div>
					</li>
				</ul>

				<div class="mt-8 border-t border-white/15 pt-8">
					<p class="text-sm font-medium text-white/70">Redes Sociais</p>
					<nav class="mt-4 flex flex-wrap gap-3" aria-label="Redes sociais">
						{
							socialLinks.map((social) => (
									<a
										href={social.href}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-[#2a3f54] text-white no-underline transition-all duration-300 hover:bg-accent hover:text-white"
										aria-label={social.label}
									>
									{social.icon === 'instagram' && (
										<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path
												d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
											></path>
										</svg>
									)}
									{social.icon === 'facebook' && (
										<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path
												d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
											></path>
										</svg>
									)}
									{social.icon === 'linkedin' && (
										<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path
												d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 114.126 0 2.063 2.063 0 01-2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
											></path>
										</svg>
									)}
									{social.icon === 'youtube' && (
										<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path
												d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
											></path>
										</svg>
									)}
								</a>
							))
						}
					</nav>
				</div>
			</div>
		</div>
	</div>
</section>
