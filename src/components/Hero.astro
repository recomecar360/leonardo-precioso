---
import { Picture } from 'astro:assets';
import heroImage from '../assets/images/leonardo-hero.png';
import { buildWhatsApp } from '../data/site';
---

<section
	id="inicio"
	class="relative min-h-[calc(100dvh-4.5rem)] w-full overflow-hidden bg-petroleum-900 lg:min-h-[calc(100dvh-5rem)]"
	aria-labelledby="hero-title"
>
	<!-- Imagem de fundo em tela cheia -->
	<div class="absolute inset-0" aria-hidden="true">
		<Picture
			src={heroImage}
			alt=""
			formats={['avif','webp']}
			widths={[480,768,1024,1920]}
			sizes="100vw"
			width={682}
			height={1024}
			class="h-full w-full object-cover object-[70%_20%] sm:object-[75%_center] lg:object-[right_center]"
			loading="eager"
			fetchpriority="high"
		/>
	</div>

	<!-- Overlays para legibilidade e integração petróleo -->
	<div
		class="pointer-events-none absolute inset-0 bg-gradient-to-r from-petroleum-900 from-25% via-petroleum-900/90 via-45% to-petroleum-900/25 to-75%"
		aria-hidden="true"
	></div>
	<div
		class="pointer-events-none absolute inset-0 bg-gradient-to-t from-petroleum-900 via-petroleum-900/40 to-transparent"
		aria-hidden="true"
	></div>
	<div
		class="pointer-events-none absolute inset-0 bg-petroleum-900/20 mix-blend-multiply"
		aria-hidden="true"
	></div>

	<!-- Marcas d'água sutis -->
	<div
		class="pointer-events-none absolute bottom-24 right-8 z-[1] hidden opacity-[0.12] lg:block"
		aria-hidden="true"
	>
		<p class="text-xs font-bold uppercase tracking-[0.35em] text-accent">RE.COMEÇAR</p>
	</div>
	<div
		class="pointer-events-none absolute right-[18%] top-1/3 z-[1] hidden max-w-[120px] opacity-[0.15] lg:block"
		aria-hidden="true"
	>
		<p class="text-[10px] font-semibold uppercase leading-tight tracking-wider text-white">
			Instituto Ação pela Paz
		</p>
	</div>

	<!-- Conteúdo -->
	<div
		class="relative z-10 mx-auto flex min-h-[inherit] w-full max-w-7xl flex-col justify-center px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24"
	>
		<div class="max-w-2xl lg:max-w-xl xl:max-w-2xl">
			<h1
				id="hero-title"
				class="text-hero-md font-bold leading-tight tracking-tight sm:text-hero-lg lg:text-hero-xl"
			>
				<span class="text-white">Leonardo Precioso: Palestras sobre </span>
				<span class="text-accent">Liderança, Gestão</span>
				<span class="text-white"> e </span>
				<span class="text-accent">Empreendedorismo Social</span>
			</h1>

			<p class="mt-6 max-w-xl text-base leading-relaxed text-white/90 sm:mt-8 sm:text-lg">
				Transforme sua equipe através de histórias reais de superação, resiliência e segundas
				chances. Inspire liderança humanizada e gestão com propósito.
			</p>

			<div class="mt-8 flex flex-col gap-4 sm:mt-10 sm:flex-row sm:flex-wrap sm:items-center">
				<a
					href={buildWhatsApp('Olá, gostaria de contratar uma palestra.')}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-accent w-full sm:w-auto"
				>
					<svg
						class="h-5 w-5 shrink-0"
						viewBox="0 0 24 24"
						fill="currentColor"
						aria-hidden="true"
					>
						<path
							d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"
						></path>
					</svg>
					Contratar Palestra
				</a>
				<a
					href={buildWhatsApp('Olá, gostaria de solicitar um orçamento.')}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-outline-white w-full sm:w-auto"
				>
					Solicitar Orçamento
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</div>

	<!-- Imagem decorativa: fundo já descrito pelo título (sr-only redundant removed) -->

	<a
		href="#sobre"
		class="absolute bottom-6 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center gap-1 text-sm text-white/80 no-underline transition-colors hover:text-accent sm:bottom-8"
		aria-label="Role para baixo"
	>
		<svg
			class="h-5 w-5 animate-bounce"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M12 5v14M19 12l-7 7-7-7"></path>
		</svg>
		<span>Role para baixo</span>
	</a>
</section>
