---
import { buildWhatsApp } from '../data/site';
import { getCollection } from 'astro:content';

const mencoes = (await getCollection('mencoes')).map((m) => m.data);
---

<section
	id="mencoes-midia"
	class="w-full bg-white py-16 sm:py-20 lg:py-28"
	aria-labelledby="mencoes-title"
>
	<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="mx-auto max-w-3xl text-center">
				<h2 id="mencoes-title" class="text-3xl font-bold tracking-tight text-navy sm:text-4xl lg:text-[2.25rem]">
				Menções{' '}
				<span class="relative inline-block">
					na
					<span class="absolute -bottom-1 left-0 right-0 mx-auto h-1 w-full rounded-full bg-accent" aria-hidden="true"></span>
				</span>{' '}
				Mídia
			</h2>
			<p class="mt-6 text-base leading-relaxed text-[#666666] sm:text-lg">
				A história de transformação de Leonardo foi destaque em importantes veículos de
				comunicação
			</p>
		</header>

		<div class="mt-12 grid gap-6 sm:mt-14 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
			{
				mencoes.map((item) => (
					<a
						href={item.href}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex flex-col rounded-2xl bg-[#1a3b5d] p-6 shadow-[0_8px_24px_rgb(26_59_93/0.25)] no-underline transition-all duration-300 hover:bg-[#15304d] hover:shadow-[0_12px_32px_rgb(26_59_93/0.35)] sm:p-7"
					>
						<div class="mb-4 flex items-start justify-between gap-3">
							<span class="text-lg font-bold text-white">{item.outlet}</span>
							<svg
								class="h-5 w-5 shrink-0 text-accent transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"></path>
								<polyline points="15 3 21 3 21 9"></polyline>
								<line x1="10" y1="14" x2="21" y2="3"></line>
							</svg>
						</div>
						<p class="flex-1 text-sm leading-relaxed text-white/90 sm:text-[0.9375rem]">
							{item.headline}
						</p>
					</a>
				))
			}
		</div>

			<footer class="mt-12 text-center sm:mt-16">
			<p class="text-base text-[#666666] sm:text-lg">
				Interessado em entrevistar Leonardo ou conhecer mais sobre sua história?
			</p>
			<a
				href={buildWhatsApp('Olá, gostaria de marcar uma entrevista.')}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-4 inline-flex items-center gap-1 text-base font-semibold text-accent-ink no-underline transition-colors hover:text-accent-dark sm:text-lg"
			>
				Entre em contato
				<span aria-hidden="true">→</span>
			</a>
		</footer>
	</div>
</section>
