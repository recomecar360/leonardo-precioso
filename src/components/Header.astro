---
import { buildWhatsApp } from '../data/site';

const navLinks = [
	{ href: '#sobre', label: 'Sobre' },
	{ href: '#palestras', label: 'Palestras' },
	{ href: '#instituto', label: 'Instituto' },
	{ href: '#midia', label: 'Mídia' },
	{ href: '#contato', label: 'Contato' },
] as const;
---

<header
	data-header
	class="sticky top-0 z-50 w-full border-b border-petroleum-700/30 bg-petroleum-900/80 backdrop-blur-md"
>
	<div
		class="mx-auto grid w-full max-w-7xl grid-cols-[1fr_auto] items-center gap-4 px-4 py-4 sm:px-6 md:grid-cols-[1fr_auto_1fr] lg:px-8"
	>
		<a
			href="#inicio"
			class="col-start-1 justify-self-start text-lg font-bold tracking-tight no-underline sm:text-xl"
			aria-label="Leonardo Precioso — início"
		>
			<span class="text-white">Leonardo </span>
			<span class="text-accent">Precioso</span>
		</a>

		<nav
			class="col-start-2 hidden items-center justify-center gap-6 lg:gap-8 md:flex"
			aria-label="Navegação principal"
		>
			{
				navLinks.map((link) => (
					<a href={link.href} class="nav-link">
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="col-start-2 flex items-center justify-end gap-3 md:col-start-3">
			<a
				href={buildWhatsApp('Olá, gostaria de mais informações.')}
				target="_blank"
				rel="noopener noreferrer"
				class="btn-whatsapp hidden sm:inline-flex"
			>
				WhatsApp
			</a>

			<button
				type="button"
				data-menu-toggle
				class="inline-flex h-11 w-11 items-center justify-center rounded-pill border border-petroleum-600 text-white transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:hidden"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Abrir menu de navegação"
			>
				<svg
					data-icon-menu
					class="h-5 w-5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
				<svg
					data-icon-close
					class="hidden h-5 w-5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
		</div>
	</div>

	<nav
		id="mobile-menu"
		data-mobile-menu
		class="hidden border-t border-petroleum-700/40 bg-petroleum-900/95 backdrop-blur-md md:hidden"
		aria-label="Menu mobile"
		aria-hidden="true"
	>
		<ul class="mx-auto flex w-full max-w-7xl flex-col gap-1 px-4 py-4 sm:px-6 lg:px-8">
			{
				navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							data-mobile-link
							class="block rounded-lg px-4 py-3 text-base font-medium text-white no-underline transition-colors hover:bg-petroleum-800 hover:text-accent"
						>
							{link.label}
						</a>
					</li>
				))
			}
			<li class="mt-2 border-t border-petroleum-700/40 pt-4">
				<a
					href={buildWhatsApp('Olá, gostaria de mais informações.')}
					target="_blank"
					rel="noopener noreferrer"
					data-mobile-link
					class="btn-whatsapp w-full"
				>
					WhatsApp
				</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	function initHeaderMenu() {
		const header = document.querySelector<HTMLElement>('[data-header]');
		if (!header) return;

		const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
		const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
		const iconMenu = header.querySelector<SVGElement>('[data-icon-menu]');
		const iconClose = header.querySelector<SVGElement>('[data-icon-close]');
		const mobileLinks = header.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]');

		if (!toggle || !menu) return;

		const openMenu = () => {
			menu.classList.remove('hidden');
			menu.setAttribute('aria-hidden', 'false');
			toggle.setAttribute('aria-expanded', 'true');
			toggle.setAttribute('aria-label', 'Fechar menu de navegação');
			iconMenu?.classList.add('hidden');
			iconClose?.classList.remove('hidden');
			document.body.style.overflow = 'hidden';
		};

		const closeMenu = () => {
			menu.classList.add('hidden');
			menu.setAttribute('aria-hidden', 'true');
			toggle.setAttribute('aria-expanded', 'false');
			toggle.setAttribute('aria-label', 'Abrir menu de navegação');
			iconMenu?.classList.remove('hidden');
			iconClose?.classList.add('hidden');
			document.body.style.overflow = '';
		};

		const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

		toggle.addEventListener('click', () => {
			isOpen() ? closeMenu() : openMenu();
		});

		mobileLinks.forEach((link) => {
			link.addEventListener('click', closeMenu);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen()) closeMenu();
		});

		window.addEventListener(
			'resize',
			() => {
				if (window.matchMedia('(min-width: 768px)').matches && isOpen()) {
					closeMenu();
				}
			},
			{ passive: true },
		);
	}

	initHeaderMenu();
	document.addEventListener('astro:page-load', initHeaderMenu);
</script>
