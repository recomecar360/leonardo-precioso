---
import { getCollection } from 'astro:content';

const faq = (await getCollection('faq')).map((f) => f.data);
---

<section
	id="faq"
	class="w-full bg-[#f5f7fa] py-16 sm:py-20 lg:py-28"
	aria-labelledby="faq-title"
>
	<div class="mx-auto w-full max-w-3xl px-4 sm:px-6 lg:px-8">
		<header class="text-center">
			<h2 id="faq-title" class="text-3xl font-bold tracking-tight text-navy sm:text-4xl lg:text-[2.25rem]">
				Perguntas Frequentes
			</h2>
			<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
			<p class="mt-6 text-base text-[#666666] sm:text-lg">
				Tire suas dúvidas sobre as palestras e o Instituto Recomeçar
			</p>
		</header>

		<div class="mt-10 space-y-4 sm:mt-12">
			{faq.map((item, idx) => (
				<details class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-[0_4px_16px_rgb(0_0_0/0.06)]" key={idx}>
					<summary class="flex w-full items-center justify-between gap-4 px-5 py-5 text-left transition-colors hover:bg-gray-50 sm:px-6">
						<span class="text-base font-bold text-navy sm:text-lg">{item.question}</span>
						<svg
							class="h-5 w-5 shrink-0 text-accent transition-transform duration-300"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M6 9l6 6 6-6"></path>
						</svg>
					</summary>
					<div class="border-t border-gray-200 px-5 py-5 sm:px-6">
						<p class="text-sm leading-relaxed text-[#333333] sm:text-base">{item.answer}</p>
					</div>
				</details>
			))}
		</div>

		<style is:inline>
			details[open] svg { transform: rotate(180deg); }
		</style>
	</div>
</section>

	<!-- No JS accordion needed: details/summary used -->
