---
import { Picture } from 'astro:assets';
import livroCapa from '../assets/images/livro-recomecar.png';
import { buildWhatsApp } from '../data/site';

const amazonUrl =
	'https://www.amazon.com.br/Recome%C3%A7ar-Leonardo-Precioso-Sabrina-Mori-ebook/dp/B09Z1QSXBC';

const features = [
	'Superação de adversidades extremas',
	'Liderança transformadora na prática',
	'Estratégias de resiliência corporativa',
	'O poder da segunda chance',
] as const;
---

<section
	id="livro"
	class="w-full bg-white py-16 sm:py-20 lg:py-28"
	aria-labelledby="livro-title"
>
	<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
		<div
			class="grid items-center gap-10 lg:grid-cols-[2fr_3fr] lg:gap-14 xl:gap-20"
		>
			<figure class="order-2 flex justify-center lg:order-1 lg:justify-start">
				<div class="max-w-sm shadow-[0_20px_50px_rgb(0_0_0/0.15)] lg:max-w-md">
					<Picture
						src={livroCapa}
						alt="Capa do livro Recomeçar — Leonardo Precioso e Sabrina Mori"
						formats={['avif','webp']}
						widths={[200,400,800]}
						sizes="(max-width: 640px) 100vw, 33vw"
						width={400}
						height={400}
						class="h-auto w-full"
						loading="lazy"
					/>
				</div>
			</figure>

			<div class="order-1 lg:order-2">
				<div class="h-1 w-12 rounded-full bg-accent" aria-hidden="true"></div>

				<h2
					id="livro-title"
					class="mt-4 text-3xl font-bold tracking-tight text-navy sm:text-4xl"
				>
					Livro Recomeçar
				</h2>
				<p class="mt-3 text-lg font-semibold text-accent-ink sm:text-xl">
					O cárcere e a necessidade de se transformar no país imutável.
				</p>

				<div class="mt-6 space-y-5 text-[0.9375rem] leading-relaxed text-[#333333] sm:text-base lg:leading-[1.75]">
					<p>
						A trajetória de Leonardo Precioso é a prova viva de que não importa onde você esteve,
						mas sim para onde você decide ir. Neste livro impactante, ele compartilha não apenas
						sua história de superação, mas um verdadeiro manual para quem busca transformar
						desafios em degraus para o sucesso.
					</p>
					<p>
						Escrito em parceria com Sabrina Mori, esta obra é um convite para líderes,
						empreendedores e qualquer pessoa que deseje desbloquear seu potencial máximo através da
						resiliência e da gestão humanizada.
					</p>
				</div>

				<ul class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-3">
					{
						features.map((feature) => (
							<li class="flex items-start gap-3">
								<svg
									class="mt-0.5 h-5 w-5 shrink-0 text-accent"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M20 6L9 17l-5-5"></path>
								</svg>
								<span class="text-sm font-medium text-navy sm:text-[0.9375rem]">
									{feature}
								</span>
							</li>
						))
					}
				</ul>

				<div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center">
					<a
						href={amazonUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3.5 text-sm font-bold text-navy no-underline transition-colors hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:text-base"
					>
						<svg
							class="h-5 w-5 shrink-0"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="9" cy="21" r="1"></circle>
							<circle cx="20" cy="21" r="1"></circle>
							<path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"></path>
						</svg>
						Comprar na Amazon
					</a>
					<a
						href={buildWhatsApp('Olá, gostaria de comprar o livro Recomeçar.')}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-navy bg-white px-6 py-3.5 text-sm font-bold text-navy no-underline transition-colors hover:bg-navy/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy sm:text-base"
					>
						<svg
							class="h-5 w-5 shrink-0"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"
							></path>
						</svg>
						Solicitar Orçamento
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
