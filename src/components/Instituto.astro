---
import { Picture } from 'astro:assets';
import institutoImage from '../assets/images/instituto-recomecar.png';
import { getCollection } from 'astro:content';

const highlight = 'font-bold text-accent';
const bold = 'font-bold text-navy';

const features = (await getCollection('palestras')).map((p) => p.data).slice(0, 3);
const stats = (await getCollection('stats')).map((s) => s.data);
---

<section
	id="instituto"
	class="w-full bg-white py-16 sm:py-20 lg:py-28"
	aria-labelledby="instituto-title"
>
	<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="text-center">
			<h2 id="instituto-title" class="text-3xl font-bold tracking-tight text-navy sm:text-4xl lg:text-[2.25rem]">
				Empreendedorismo Social e Impacto
			</h2>
			<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
		</header>

		<div
			class="mt-12 grid items-start gap-10 lg:mt-16 lg:grid-cols-2 lg:gap-14 xl:gap-20"
		>
			<figure class="order-2 lg:order-1">
				<div class="overflow-hidden rounded-2xl shadow-[0_8px_30px_rgb(0_0_0/0.12)]">
					<Picture
						src={institutoImage}
						alt="Equipe do Instituto Recomeçar — projeto De Quebrada em Quebrada"
						formats={['avif','webp']}
						widths={[360,720,1080]}
						sizes="(max-width: 768px) 100vw, 50vw"
						width={720}
						height={480}
						class="aspect-[3/2] h-auto w-full object-cover"
						loading="lazy"
					/>
				</div>
			</figure>

			<div class="order-1 flex flex-col gap-8 lg:order-2">
				<div>
					<h3 class="text-xl font-bold text-navy sm:text-2xl">Instituto Recomeçar</h3>

					<div class="mt-5 space-y-5 text-[0.9375rem] leading-relaxed text-[#333333] sm:text-base lg:leading-[1.75]">
						<p>
							O <span class={highlight}>Instituto Recomeçar</span> é uma organização dedicada ao
							desenvolvimento e preparação de ex-presidiários para o mercado de trabalho, oferecendo
							uma verdadeira <span class={bold}>segunda chance</span> através da educação e
							capacitação profissional.
						</p>
						<p>
							Nossa missão é promover a <span class={bold}>reintegração social</span> e
							<span class={bold}>profissional</span>, quebrando barreiras e construindo pontes entre
							ex-detentos e oportunidades reais de crescimento.
						</p>
					</div>
				</div>

				<ul class="space-y-4">
					{
						features.map((feature) => (
							<li class="flex gap-4">
								<div
									class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-accent/15 text-accent"
									aria-hidden="true"
								>
									{feature.icon === 'book' && (
										<svg
											class="h-6 w-6"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M4 19.5A2.5 2.5 0 016.5 17H20" />
											<path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" />
										</svg>
									)}
									{feature.icon === 'building' && (
										<svg
											class="h-6 w-6"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M3 21h18M6 21V7l6-4 6 4v14M10 11h4M10 15h4" />
										</svg>
									)}
									{feature.icon === 'trend' && (
										<svg
											class="h-6 w-6"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M3 3v18h18" />
											<path d="M7 14l4-4 4 4 5-6" />
										</svg>
									)}
								</div>
								<div>
									<h4 class="font-bold text-navy">{feature.title}</h4>
									<p class="mt-1 text-sm leading-relaxed text-[#555555] sm:text-[0.9375rem]">
										{feature.description}
									</p>
								</div>
							</li>
						))
					}
				</ul>

				<a
					href="https://recomecar360.org"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex w-fit items-center justify-center rounded-pill bg-navy px-8 py-3.5 text-sm font-bold text-white no-underline transition-colors hover:bg-[#002244] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy sm:text-base"
				>
					Conhecer o Instituto
				</a>
			</div>
		</div>

		<div class="mt-14 rounded-2xl bg-navy px-6 py-10 sm:mt-16 sm:rounded-3xl sm:px-10 sm:py-12 lg:mt-20">
			<h3 class="text-center text-xl font-bold text-white sm:text-2xl">Nosso Impacto</h3>

			<dl class="mt-8 grid grid-cols-2 gap-8 sm:gap-10 lg:grid-cols-4 lg:gap-6">
				{
					stats.map((stat) => (
						<div class="text-center">
							<dt class="text-3xl font-bold text-accent sm:text-4xl lg:text-[2.5rem]">
								{stat.value}
							</dt>
							<dd class="mt-2 text-sm text-white/90 sm:text-base">{stat.label}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
</section>
