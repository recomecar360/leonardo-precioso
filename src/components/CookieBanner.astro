---
import cookieData from '../data/cookies.json';

const { storageKey, banner } = cookieData;
---

<div
	id="cookie-banner"
	class="fixed inset-x-0 bottom-0 z-[100] hidden translate-y-0 border-t border-white/10 bg-petroleum-850 shadow-[0_-8px_32px_rgb(0_0_0/0.35)]"
	role="dialog"
	aria-labelledby="cookie-banner-title"
	aria-describedby="cookie-banner-desc"
	aria-modal="false"
	data-cookie-banner
	data-storage-key={storageKey}
>
	<div class="mx-auto flex w-full max-w-7xl flex-col gap-5 px-4 py-5 sm:px-6 sm:py-6 lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:px-8">
		<div class="min-w-0 flex-1">
			<h2 id="cookie-banner-title" class="text-base font-bold text-white sm:text-lg">
				{banner.title}
			</h2>
			<p id="cookie-banner-desc" class="mt-2 text-sm leading-relaxed text-white/75">
				{banner.message}{' '}
				<a
					href={banner.policyHref}
					class="font-semibold text-accent underline decoration-accent/50 underline-offset-2 transition-colors hover:text-accent-dark"
				>
					{banner.policyLabel}
				</a>
				.
			</p>
		</div>

		<div class="flex shrink-0 flex-col gap-3 sm:flex-row sm:items-center">
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-pill border-2 border-white/40 bg-transparent px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
				data-cookie-reject
			>
				{banner.rejectLabel}
			</button>
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-pill bg-accent px-6 py-2.5 text-sm font-bold text-petroleum-950 transition-colors hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
				data-cookie-accept
			>
				{banner.acceptLabel}
			</button>
		</div>
	</div>
</div>

<script>
	function initCookieBanner() {
		const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');
		if (!banner) return;

		const storageKey = banner.dataset.storageKey ?? 'leonardo-precioso-cookie-consent';
		const acceptBtn = banner.querySelector<HTMLButtonElement>('[data-cookie-accept]');
		const rejectBtn = banner.querySelector<HTMLButtonElement>('[data-cookie-reject]');

		const hide = () => {
			banner.classList.add('hidden');
			banner.setAttribute('aria-hidden', 'true');
		};

		const show = () => {
			banner.classList.remove('hidden');
			banner.removeAttribute('aria-hidden');
		};

		const saveConsent = (value: 'accepted' | 'rejected') => {
			try {
				localStorage.setItem(storageKey, value);
			} catch {
				/* armazenamento indisponível */
			}
			hide();
		};

		try {
			const stored = localStorage.getItem(storageKey);
			if (stored === 'accepted' || stored === 'rejected') {
				hide();
				return;
			}
		} catch {
			/* segue para exibir o banner */
		}

		show();

		acceptBtn?.addEventListener('click', () => saveConsent('accepted'));
		rejectBtn?.addEventListener('click', () => saveConsent('rejected'));
	}

	initCookieBanner();
	document.addEventListener('astro:page-load', initCookieBanner);
</script>
