---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import cookieData from '../data/cookies.json';

const { policy } = cookieData;
---

<Layout title={policy.title} description={policy.description}>
	<Header />
	<main class="w-full flex-1 py-16 sm:py-20 lg:py-24">
		<article class="mx-auto w-full max-w-3xl px-4 sm:px-6 lg:px-8">
			<header class="text-center">
				<h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
					{policy.title}
				</h1>
				<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
				<p class="mt-4 text-sm text-white/60">Última atualização: {policy.lastUpdated}</p>
			</header>

			<div class="mt-10 space-y-10">
				{
					policy.sections.map((section) => (
						<section>
							<h2 class="text-xl font-bold text-white">{section.heading}</h2>
							{'paragraphs' in section &&
								section.paragraphs?.map((paragraph) => (
									<p class="mt-4 text-sm leading-relaxed text-white/75 sm:text-base">
										{paragraph}
									</p>
								))}
							{'list' in section && section.list && (
								<ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-white/75 sm:text-base">
									{section.list.map((item) => (
										<li>{item}</li>
									))}
								</ul>
							)}
						</section>
					))
				}
			</div>

			<p class="mt-12 text-center">
				<a
					href="/"
					class="text-sm font-semibold text-accent no-underline transition-colors hover:text-accent-dark"
				>
					← Voltar ao início
				</a>
			</p>
		</article>
	</main>
	<Footer />
</Layout>
