---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada" description="Página não encontrada" noindex>
	<main class="min-h-[60vh] flex items-center justify-center p-8">
		<div class="text-center">
			<h1 class="text-4xl font-bold">404 — Página não encontrada</h1>
			<p class="mt-4 text-lg">A página que você procura não existe. <a href="/" class="text-accent underline">Voltar para a home</a></p>
		</div>
	</main>
</Layout>

