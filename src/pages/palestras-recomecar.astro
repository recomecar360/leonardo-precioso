---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import fabioKapitanovas from '../assets/images/fabio-kapitanovas-face.jpg';
import flavioDias from '../assets/images/flavio-dias-rosto.jpg';
import gabrielConcon from '../assets/images/gabriel-concon.jpg';
import gilbertoLopes from '../assets/images/gilberto-lopes.png';
import josmarMachado from '../assets/images/josmar-machado-rosto.jpg';
import leoPrecioso from '../assets/images/leo-precioso.jpg';
import rudiFisher from '../assets/images/rudi-fisher.png';
import sandraGioffi from '../assets/images/sandra-gioffi.png';

const fotosConselheiros = {
	'fabio-kapitanovas': fabioKapitanovas,
	'flavio-dias': flavioDias,
	'gabriel-concon': gabrielConcon,
	'gilberto-lopes': gilbertoLopes,
	'josmar-machado': josmarMachado,
	'leo-precioso': leoPrecioso,
	'rudi-fisher': rudiFisher,
	'sandra-gioffi': sandraGioffi,
} as const;

const enquadramento: Record<string, string> = {
	'fabio-kapitanovas': 'object-center',
	'flavio-dias': 'object-center',
	'gabriel-concon': 'object-center',
	'gilberto-lopes': 'object-[center_30%]',
	'josmar-machado': 'object-center',
	'leo-precioso': 'object-center',
	'rudi-fisher': 'object-center',
	'sandra-gioffi': 'object-center',
};

const byId = <T extends { id: string }>(items: T[]) =>
	[...items].sort((a, b) => a.id.localeCompare(b.id, 'pt-BR', { numeric: true }));

const conselheiros = byId(await getCollection('conselheiros')).map((c) => c.data);
const temas = byId(await getCollection('recomecarTemas')).map((t) => t.data);
const pacotes = byId(await getCollection('recomecarPacotes')).map((p) => p.data);
const beneficios = byId(await getCollection('recomecarBeneficios')).map((b) => b.data);
const passos = (await getCollection('recomecarPassos'))
	.map((s) => s.data)
	.sort((a, b) => a.step - b.step);
const impacto = byId(await getCollection('recomecarImpacto')).map((i) => i.data);

const ctaMessage = 'Olá, gostaria de contratar uma palestra/mentoria através do Instituto Recomeçar.';
const ctaLink = `https://wa.me/5511961485763?text=${encodeURIComponent(ctaMessage)}`;
const email = 'senna.ricarte@recomecar360.org';

const navLinks = [
	{ href: '/', label: 'Início' },
	{ href: '#recomecar', label: 'Recomeçar' },
	{ href: '#temas', label: 'Temas' },
	{ href: '#conselheiros', label: 'Conselheiros' },
	{ href: '#pacotes', label: 'Pacotes' },
	{ href: '#contato-final', label: 'Contato' },
];

const modelo = [
	{
		step: '1',
		title: 'Conselheiros como palestrantes',
		text: 'Especialistas doam seu tempo e conhecimento para eventos e mentorias.',
	},
	{
		step: '2',
		title: 'Contratação pela empresa',
		text: 'Escolha tema, palestrante e formato — nós cuidamos do resto.',
	},
	{
		step: '3',
		title: 'Valor revertido',
		text: '100% do valor é destinado aos projetos e programas do Instituto.',
	},
];
---

<Layout
	title="Palestras & Mentorias Recomeçar — Inspiração que Transforma"
	description="Contrate palestras e mentorias com executivos e especialistas. 100% da receita revertida para o Instituto Recomeçar."
>
	<Header navLinks={navLinks} logoHref="/" />

	<section
		id="inicio"
		class="relative w-full overflow-hidden bg-petroleum-900 py-20 sm:py-24 lg:py-32"
		aria-labelledby="hero-title"
	>
		<div
			class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(240,179,35,0.16),transparent_55%)]"
			aria-hidden="true"
		></div>
		<div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl">
				<p class="text-xs font-bold uppercase tracking-[0.35em] text-accent">Instituto Recomeçar</p>
				<h1
					id="hero-title"
					class="mt-5 text-hero-md font-bold leading-tight tracking-tight text-white sm:text-hero-lg lg:text-hero-xl"
				>
					Palestras & Mentorias <span class="text-accent">Recomeçar</span>
				</h1>
				<p class="mt-6 max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg">
					Inspiração que transforma. 100% do valor revertido para impacto social.
				</p>
				<div class="mt-8 flex flex-col gap-4 sm:mt-10 sm:flex-row sm:flex-wrap sm:items-center">
					<a href={ctaLink} target="_blank" rel="noopener noreferrer" class="btn-accent w-full sm:w-auto">
						Contratar palestra
					</a>
					<a href="#pacotes" class="btn-outline-white w-full sm:w-auto">
						Ver pacotes
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<main>
		<section id="recomecar" class="w-full bg-white py-16 sm:py-20 lg:py-28" aria-labelledby="recomecar-title">
			<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
				<header class="mx-auto max-w-3xl text-center">
					<h2
						id="recomecar-title"
						class="text-3xl font-bold tracking-tight text-navy sm:text-4xl lg:text-[2.25rem]"
					>
						O Recomeçar
					</h2>
					<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
					<p class="mt-6 text-base leading-relaxed text-[#333333] sm:text-lg">
						O Instituto Recomeçar promove formação, reinserção e oportunidades de trabalho para
						pessoas em situação de vulnerabilidade, conectando conhecimento corporativo com impacto
						social.
					</p>
				</header>

				<div class="mt-12 rounded-2xl bg-navy px-6 py-10 sm:mt-14 sm:rounded-3xl sm:px-10 sm:py-12">
					<h3 class="text-center text-xl font-bold text-white sm:text-2xl">Nosso impacto</h3>
					<dl class="mt-8 grid gap-8 sm:grid-cols-3 sm:gap-10">
						{
							impacto.map((item) => (
								<div class="text-center">
									<dt class="text-3xl font-bold text-accent sm:text-4xl">{item.value}</dt>
									<dd class="mt-2 text-sm leading-relaxed text-white/90 sm:text-base">{item.label}</dd>
								</div>
							))
						}
					</dl>
				</div>
			</div>
		</section>

		<section id="modelo" class="w-full bg-petroleum-900 py-16 sm:py-20 lg:py-28" aria-labelledby="modelo-title">
			<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
				<header class="mx-auto max-w-3xl text-center">
					<h2
						id="modelo-title"
						class="text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-[2.25rem]"
					>
						Unir conhecimento e impacto
					</h2>
					<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
					<p class="mt-6 text-base leading-relaxed text-white/85 sm:text-lg">
						Executivos e especialistas doam sua experiência como conselheiros e palestrantes;
						empresas contratam eventos e mentorias, e todo valor é revertido para os projetos do
						Instituto Recomeçar.
					</p>
				</header>

				<ol id="como-funciona" class="mt-12 grid gap-6 sm:mt-14 md:grid-cols-3 lg:mt-16 lg:gap-8">
					{
						modelo.map((item) => (
							<li class="flex flex-col rounded-2xl bg-white p-6 shadow-[0_8px_30px_rgb(0_0_0/0.15)] sm:rounded-3xl sm:p-8">
								<span class="flex h-12 w-12 items-center justify-center rounded-full bg-accent text-lg font-bold text-petroleum-950">
									{item.step}
								</span>
								<h3 class="mt-5 text-lg font-bold leading-snug text-navy sm:text-xl">{item.title}</h3>
								<p class="mt-3 text-sm leading-relaxed text-[#4a5568] sm:text-[0.9375rem]">{item.text}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section id="temas" class="w-full bg-[#f5f7fa] py-16 sm:py-20 lg:py-28" aria-labelledby="temas-title">
			<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
				<header class="mx-auto max-w-3xl text-center">
					<h2 id="temas-title" class="text-3xl font-bold tracking-tight text-navy sm:text-4xl lg:text-[2.25rem]">
						Temas
					</h2>
					<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
					<p class="mt-6 text-base text-[#666666] sm:text-lg">
						Conteúdos para liderança, cultura e transformação nas empresas
					</p>
				</header>

				<ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-5">
					{
						temas.map((tema) => (
							<li class="rounded-2xl border border-black/5 bg-white px-5 py-5 shadow-[0_4px_16px_rgb(0_0_0/0.06)] sm:px-6">
								<h3 class="text-base font-bold leading-snug text-navy sm:text-lg">{tema.title}</h3>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section
			id="conselheiros"
			class="w-full bg-petroleum-900 py-16 sm:py-20 lg:py-28"
			aria-labelledby="conselheiros-title"
		>
			<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
				<header class="mx-auto max-w-3xl text-center">
					<h2
						id="conselheiros-title"
						class="text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-[2.25rem]"
					>
						Conselheiros
					</h2>
					<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
					<p class="mt-6 text-base text-white/85 sm:text-lg">
						Executivos e especialistas que doam experiência para gerar impacto
					</p>
				</header>

				<ul class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-8">
					{
						conselheiros.map((conselheiro) => {
							const initials = conselheiro.name
								.split(' ')
								.map((part) => part[0])
								.join('')
								.slice(0, 2)
								.toUpperCase();
							return (
								<li class="rounded-2xl bg-white p-6 text-center shadow-[0_8px_30px_rgb(0_0_0/0.15)] sm:rounded-3xl sm:p-8">
									{conselheiro.photo && conselheiro.photo in fotosConselheiros ? (
										<Image
											src={fotosConselheiros[conselheiro.photo as keyof typeof fotosConselheiros]}
											alt={`${conselheiro.name}, ${conselheiro.role}`}
											format="webp"
											quality="mid"
											width={384}
											height={384}
											class:list={[
												'mx-auto h-48 w-48 rounded-full object-cover',
												conselheiro.photo
													? (enquadramento[conselheiro.photo] ?? 'object-[center_18%]')
													: 'object-[center_18%]',
											]}
											loading="lazy"
										/>
									) : (
										<div
											class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-accent text-xl font-bold text-petroleum-950"
											aria-hidden="true"
										>
											{initials}
										</div>
									)}
									<h3 class="mt-4 text-lg font-bold text-navy">{conselheiro.name}</h3>
									<p class="mt-1 text-sm leading-relaxed text-[#555555]">{conselheiro.role}</p>
									<a
										href={conselheiro.linkedin}
										target="_blank"
										rel="noopener noreferrer"
										class="mt-4 inline-flex text-sm font-semibold text-accent-ink no-underline transition-colors hover:text-navy"
										aria-label={`LinkedIn de ${conselheiro.name}`}
									>
										LinkedIn
									</a>
								</li>
							);
						})
					}
				</ul>
			</div>
		</section>

		<section id="contratar" class="w-full bg-white py-16 sm:py-20 lg:py-28" aria-labelledby="contratar-title">
			<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
				<header class="mx-auto max-w-3xl text-center">
					<h2
						id="contratar-title"
						class="text-3xl font-bold tracking-tight text-navy sm:text-4xl lg:text-[2.25rem]"
					>
						Como contratar
					</h2>
					<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
				</header>

				<ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-8">
					{
						passos.map((passo) => (
							<li class="rounded-2xl bg-[#f8f9fa] p-6 text-center sm:p-7">
								<span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-accent text-lg font-bold text-petroleum-950">
									{passo.step}
								</span>
								<h3 class="mt-4 font-bold leading-snug text-navy">{passo.title}</h3>
								{passo.detail ? (
									<p class="mt-2 text-sm leading-relaxed text-[#555555]">{passo.detail}</p>
								) : null}
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section id="pacotes" class="w-full bg-petroleum-900 py-16 sm:py-20 lg:py-28" aria-labelledby="pacotes-title">
			<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
				<header class="mx-auto max-w-3xl text-center">
					<h2
						id="pacotes-title"
						class="text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-[2.25rem]"
					>
						Pacotes e investimento
					</h2>
					<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
				</header>

				<div class="mt-12 grid gap-6 md:grid-cols-2 lg:mt-14 lg:gap-8">
					{
						pacotes.map((pacote) => (
							<article class="flex flex-col rounded-2xl bg-white p-6 shadow-[0_8px_30px_rgb(0_0_0/0.15)] sm:rounded-3xl sm:p-8">
								<p class="text-xs font-bold uppercase tracking-[0.2em] text-accent-ink">{pacote.format}</p>
								<h3 class="mt-2 text-2xl font-bold text-navy">{pacote.title}</h3>
								<ul class="mt-6 flex-1 space-y-3">
									{pacote.items.map((item) => (
										<li class="flex gap-3 text-sm leading-relaxed text-[#333333] sm:text-[0.9375rem]">
											<span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true" />
											{item}
										</li>
									))}
								</ul>
								<p class="mt-8 text-3xl font-bold tracking-tight text-navy">{pacote.price}</p>
								<a
									href={ctaLink}
									target="_blank"
									rel="noopener noreferrer"
									class="btn-accent mt-6 w-full"
								>
									Contratar
								</a>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section id="beneficios" class="w-full bg-white py-16 sm:py-20 lg:py-28" aria-labelledby="beneficios-title">
			<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
				<header class="mx-auto max-w-3xl text-center">
					<h2
						id="beneficios-title"
						class="text-3xl font-bold tracking-tight text-navy sm:text-4xl lg:text-[2.25rem]"
					>
						Benefícios para empresas
					</h2>
					<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
				</header>

				<div class="mt-12 grid gap-6 md:grid-cols-3 lg:mt-14 lg:gap-8">
					{
						beneficios.map((beneficio) => (
							<article class="rounded-2xl bg-[#f8f9fa] p-6 sm:p-8">
								<div class="mb-4 h-1 w-10 rounded-full bg-accent" aria-hidden="true"></div>
								<h3 class="text-lg font-bold text-navy sm:text-xl">{beneficio.title}</h3>
								<p class="mt-3 text-sm leading-relaxed text-[#555555] sm:text-[0.9375rem]">
									{beneficio.description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section
			id="contato-final"
			class="w-full bg-petroleum-900 py-16 sm:py-20 lg:py-28"
			aria-labelledby="contato-final-title"
		>
			<div class="mx-auto w-full max-w-3xl px-4 text-center sm:px-6 lg:px-8">
				<h2
					id="contato-final-title"
					class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-[2.25rem]"
				>
					Entre em contato
				</h2>
				<div class="mx-auto mt-4 h-1 w-16 rounded-full bg-accent" aria-hidden="true"></div>
				<p class="mt-6 text-base leading-relaxed text-white/85 sm:text-lg">
					Pronto para levar uma palestra ou mentoria Recomeçar para a sua empresa?
				</p>
				<div class="mt-8 flex flex-col items-center gap-4 sm:mt-10">
					<a href={ctaLink} target="_blank" rel="noopener noreferrer" class="btn-accent w-full sm:w-auto">
						Falar no WhatsApp
					</a>
					<a
						href={`mailto:${email}`}
						class="text-sm font-medium text-white/80 no-underline transition-colors hover:text-accent sm:text-base"
					>
						{email}
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
